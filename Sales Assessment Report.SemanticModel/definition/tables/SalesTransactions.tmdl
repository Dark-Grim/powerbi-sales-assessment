	/// Drill-down hierarchy: Region > Product Category > Salesperson
	hierarchy 'Sales Drill-Down'
		displayFolder: Hierarchies
		lineageTag: af06d60a-5ee7-4604-bdbc-ca729225a255

		level Region
			lineageTag: caeb2c4c-6282-4b57-9f51-2470e3cbc17e
			column: Region

		level 'Product Category'
			lineageTag: 30155c23-0198-465f-9c0f-917623dea55e
			column: ProductCategory

		level Salesperson
			lineageTag: 81d1bf7e-9d5b-469e-bf6a-9c46005f9d3e
			column: SalespersonName

	partition SalesTransactions = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database(ServerName, DatabaseName, [
				        Query = "
				            SELECT
				                ST.RowID,
				                ST.TransactionID,
				                CAST(ST.SaleDate AS DATE)                  AS SaleDate,
				                ST.ProductID,
				                CASE
				                    WHEN ST.ProductCategory IS NULL
				                      OR TRIM(ST.ProductCategory) = ''
				                      OR UPPER(TRIM(ST.ProductCategory)) = 'UNKNOWN'
				                    THEN COALESCE(
				                            (SELECT TOP 1 TRIM(P.Category)
				                             FROM dbo.Products P
				                             WHERE P.ProductID = ST.ProductID),
				                            'Uncategorized'
				                         )
				                    ELSE TRIM(ST.ProductCategory)
				                END                                        AS ProductCategory,
				                CASE
				                    WHEN ST.Region IS NULL
				                      OR TRIM(ST.Region) = ''
				                      OR UPPER(TRIM(ST.Region)) = 'UNKNOWN'
				                    THEN COALESCE(
				                            (SELECT TOP 1 TRIM(SP.Region)
				                             FROM dbo.Salesperson SP
				                             WHERE SP.SalespersonID = ST.SalespersonID),
				                            'Unassigned'
				                         )
				                    ELSE TRIM(ST.Region)
				                END                                        AS Region,
				                TRIM(ST.SalesChannel)                      AS SalesChannel,
				                ST.SalespersonID,
				                TRIM(SP.SalespersonName)                   AS SalespersonName,
				                ABS(ST.QuantitySold)                       AS QuantitySold,
				                CASE
				                    WHEN ST.DiscountPct < 0   THEN 0
				                    WHEN ST.DiscountPct > 100 THEN 100
				                    ELSE ST.DiscountPct
				                END                                        AS DiscountPct
				            FROM dbo.SalesTransactions ST
				            LEFT JOIN dbo.Salesperson SP
				                ON SP.SalespersonID = ST.SalespersonID
				            WHERE ST.RowID          IS NOT NULL
				              AND ST.TransactionID  IS NOT NULL
				              AND ST.SaleDate       IS NOT NULL
				              AND ST.SaleDate       <= CAST(GETDATE() AS DATE)
				              AND ST.ProductID      IS NOT NULL
				              AND ST.SalespersonID  IS NOT NULL AND TRIM(ST.SalespersonID) <> ''
				              AND ST.SalesChannel   IS NOT NULL
				              AND TRIM(ST.SalesChannel) IN ('Online', 'In-store')
				              AND ST.QuantitySold   IS NOT NULL AND ST.QuantitySold > 0
				              AND ST.DiscountPct    IS NOT NULL AND ST.DiscountPct >= 0
				        "
				    ])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

