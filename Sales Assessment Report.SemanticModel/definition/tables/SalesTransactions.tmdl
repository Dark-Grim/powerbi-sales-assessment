table SalesTransactions
	lineageTag: 9cf3b60d-e229-4e7c-bace-43c771af475c

	/// Total revenue before discount = QuantitySold x Price
	measure 'Gross Sales' = SUMX(SalesTransactions, SalesTransactions[QuantitySold] * RELATED(Products[Price]))
		formatString: #,##0.00
		displayFolder: Sales Metrics
		lineageTag: cefa9cf6-afb8-4713-9cac-c221fd8b1c87

	/// Total discount given = QuantitySold x Price x DiscountPct%
	measure 'Total Discount Amount' = SUMX(SalesTransactions, SalesTransactions[QuantitySold] * RELATED(Products[Price]) * SalesTransactions[DiscountPct] / 100)
		formatString: #,##0.00
		displayFolder: Sales Metrics
		lineageTag: b1283b09-d4d0-4f00-bf5c-0bd41c2f5678

	/// Total revenue after discount = QuantitySold x Price x (1 - DiscountPct%)
	measure 'Net Sales' = SUMX(SalesTransactions, SalesTransactions[QuantitySold] * RELATED(Products[Price]) * (1 - SalesTransactions[DiscountPct] / 100))
		formatString: #,##0.00
		displayFolder: Sales Metrics
		lineageTag: 5defcadd-0857-4796-b889-ce3b97c52be4

	/// Total units sold
	measure 'Total Quantity Sold' = SUM(SalesTransactions[QuantitySold])
		formatString: #,##0
		displayFolder: Sales Metrics
		lineageTag: 497c31e1-3b3a-4c05-ad33-31d0e3ec9d7a

	/// Average discount percentage across all transactions
	measure 'Avg Discount %' = AVERAGE(SalesTransactions[DiscountPct])
		formatString: 0.00%
		displayFolder: Sales Metrics
		lineageTag: 74823ce1-3f06-40d7-bf8c-17b6ff892e50

	/// Total Sales = Gross Sales (QuantitySold x Price before discount) - primary sales metric for reports
	measure 'Total Sales' = SUMX(SalesTransactions, SalesTransactions[QuantitySold] * RELATED(Products[Price]))
		formatString: #,##0.00
		displayFolder: Sales Metrics
		lineageTag: 512f374d-2902-415a-9b58-8dc94f5564a9

